{
  "name": "@re-cinq/lore-assembly-lines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy:assembly-lines",
    "copy:assembly-lines": "mkdir -p dist/assembly-lines && cp -f src/assembly-lines/*.yaml dist/assembly-lines/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@re-cinq/lore-shared": "*",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  }
}
