{
  "name": "@re-cinq/lore-server-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proxy.js": {
      "types": "./dist/outbound/proxy.d.ts",
      "default": "./dist/outbound/proxy.js"
    },
    "./features/*.js": {
      "types": "./dist/work/*.d.ts",
      "default": "./dist/work/*.js"
    },
    "./platform/*.js": {
      "types": "./dist/outbound/*.d.ts",
      "default": "./dist/outbound/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@re-cinq/lore-shared": "*",
    "@opentelemetry/api": "^1.9.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
