{
  "name": "@re-cinq/lore-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./cli.js": { "types": "./dist/cli.d.ts", "default": "./dist/cli.js" }
  },
  "scripts": {
    "build": "tsc && npm run copy:workflows",
    "copy:workflows": "mkdir -p dist/workflows && cp -f src/workflows/*.yaml dist/workflows/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@re-cinq/lore-shared": "*",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  }
}
