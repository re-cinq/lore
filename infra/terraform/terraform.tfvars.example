# ---------------------------------------------------------------------------
# Terraform variables for the Lore platform.
#
# There is NOTHING SECRET IN THIS FILE, by design. Secret material lives in GCP
# Secret Manager and nowhere else — Terraform declares the containers
# (secrets.tf) and resolves values by NAME at apply/runtime. To set or rotate a
# credential, see docs/rotating-secrets.md; to seed a fresh environment, run
# scripts/infra/seed-secrets.sh.
#
# Copy this file to `terraform.tfvars`. Terraform loads that name automatically,
# so `terraform apply` needs no -var-file flag. Because it holds only
# identifiers and hostnames, a team can safely commit its real terraform.tfvars
# (drop the `*.tfvars` line from .gitignore) — that is the point of moving the
# secrets out, and it is what stops one stale checkout from breaking a deploy.
# ---------------------------------------------------------------------------

# --- GCP project + GKE cluster ---
project_id   = "your-gcp-project-id"
cluster_name = "your-gke-cluster"
region       = "europe-west1"

# --- Public URLs + hostnames (drive the Terraform-owned ingresses) ---
lore_api_url     = "https://lore-api.example.com"
lore_ui_url      = "https://lore.example.com"
lore_ui_hostname = "lore.example.com"
github_org       = "your-github-org"
github_app_slug  = "your-github-app-slug"

# Shared agent MCP gateway. Empty ("") disables its ingress and leaves the
# seeded agent recipes without a live MCP endpoint (the mcp_servers block is
# omitted). Set it to turn agent MCP access on.
lore_mcp_url = "https://lore-mcp.example.com"

# Floor /api/webhook ingress host: CI ingest doors plus the legacy
# /api/webhook/github alias (rewritten to the event-router). Empty ("")
# disables that ingress.
lore_webhook_hostname = "lore-webhook.example.com"

# The event-router front door: the canonical GitHub webhook URL (ADR-044).
lore_event_router_hostname = "lore-events.example.com"

# --- Feature gates ---
#
# These decide whether a resource EXISTS. They are deployment topology, not
# credentials — the secret each one gates is seeded in GCP Secret Manager.

# Adds the `anthropic-admin-key` entry (from `lore-anthropic-admin-api-key`) to
# the anthropic ExternalSecrets, for the cost-sync maintenance job.
enable_anthropic_admin_key = false

# Gemini credential for agent runs (GEMINI_API_KEY into agent-secrets + the
# gemini model family in the central catalog render). Seed lore-gemini-api-key
# before or right after the apply; a listed family with no key in the Secret
# fails run pods on their secretKeyRef.
enable_gemini = false

# Wiring to the external floor engine in namespace `floor` (FLOOR_* env on
# lore-api + stations, its service tokens, lore-mcp-auth in its agent-secrets).
# Seed lore-floor-service-token and lore-floor-git-credential-token first.
enable_external_floor = false

# Headlamp and the metrics stack run on the internal cluster from
# re-cinq/infrastructure; these keep their lore-* Secret Manager entries and
# Grafana's GCP identity.
enable_headlamp   = false
enable_monitoring = false

# Utopia runs on the internal cluster from re-cinq/utopia; this keeps only its
# lore-utopia-* Secret Manager entries.
enable_utopia = false

# Let lore-api create a repo's Utopia knowledge base on its first spec/ADR ingest,
# with the write token of the Lore person in Utopia (seed lore-utopia-lore-api-token
# first, docs/managing-secrets.md). Needs deeplethe/utopia#1244 deployed.
enable_utopia_auto_setup = false
utopia_lore_workspace_id = ""

# Mirror the lore-reviewer GitHub App into lore-stations, so the auto-merge loop
# can approve the pull requests Lore's own App opened. The apply creates the three
# lore-reviewer-app-* containers; add their versions after it (docs/managing-secrets.md).
enable_lore_reviewer = false

# Cloud Billing budget for this project, stated per week (see budget.tf: Google
# only resets budgets monthly, so it is applied as weekly * 52 / 12, with a
# forecast rule that fires the moment the run rate exceeds the weekly pace).
# Alerts only, never a spend cap. Applying needs Billing Account Costs Manager.
enable_gcp_budget       = false
gcp_billing_account     = "012345-6789AB-CDEF01"
# In the billing account's own currency (DKK on this account; ~7000 DKK = ~USD 1000).
gcp_budget_weekly       = 7000
gcp_budget_alert_emails = []

# --- Misc ---
log_retention_days = 30
