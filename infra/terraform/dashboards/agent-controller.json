{
 "uid": "lore-agent-controller",
 "title": "Lore \u00b7 Agent controller",
 "description": "The ai-agent-subsystem controller: how agent runs end, how long they take and wait, and the controller's own health.",
 "tags": [
  "lore"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": true,
 "graphTooltip": 1,
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "Pending",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(controller_agents{phase=\"Pending\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
