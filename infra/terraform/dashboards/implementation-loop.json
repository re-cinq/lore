  {
   "type": "table",
   "title": "Each step: runs, failures and typical time",
   "description": "Times run, share that broke, typical (median) and 9-in-10 time, and AI cost, over the dashboard's time range. Durations are not split by repository.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (line_id, node_id, kind) (increase(floor_visits_started_total{line_id=~\"$line\", repo=~\"(?i)$repo\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (line_id, node_id, kind) (increase(floor_visits_total{line_id=~\"$line\", repo=~\"(?i)$repo\", outcome=\"failed\"}[$__range])) / sum by (line_id, node_id, kind) (increase(floor_visits_total{line_id=~\"$line\", repo=~\"(?i)$repo\"}[$__range]))",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (line_id, node_id, le) (increase(floor_visit_duration_seconds_bucket{line_id=~\"$line\"}[$__range])))",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.9, sum by (line_id, node_id, le) (increase(floor_visit_duration_seconds_bucket{line_id=~\"$line\"}[$__range])))",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (line_id, node_id) (increase(floor_cost_usd_total{line_id=~\"$line\", repo=~\"(?i)$repo\"}[$__range]))",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "line_id": "Line",
       "node_id": "Step",
       "kind": "Kind",
       "Value #A": "Times run",
       "Value #B": "Broke",
       "Value #C": "Typical time",
       "Value #D": "9 in 10 within",
       "Value #E": "AI cost"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
