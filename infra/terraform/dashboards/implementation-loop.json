{
 "uid": "lore-implementation-loop",
 "title": "Lore \u00b7 Implementation loop",
 "description": "The implementation loop live: tickets it settled, steps by type per hour, each step's failures, times and AI cost, by repository. The weekend report of 2026-10-23 in docs/building-lore is the same view, after the fact.",
 "tags": [
  "lore"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-3d",
  "to": "now"
 },
 "refresh": "1m",
 "editable": true,
 "graphTooltip": 1,
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "type": "query",
    "name": "repo",
    "label": "Repository",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(floor_visits_started_total, repo)",
     "refId": "var"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "sort": 1,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "options": []
   },
   {
    "type": "custom",
    "name": "line",
    "label": "Assembly lines",
    "query": "implementation-loop,code-review,code-review-recheck,auto-merge",
    "includeAll": true,
    "allValue": "implementation-loop|code-review|code-review-recheck|auto-merge",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "options": []
   }
  ]
 },
