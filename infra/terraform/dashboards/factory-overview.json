    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "kube-state-metrics requests priced at the same Autopilot rates lore-api uses for /spend's estimate; the invoice is the Billed panels."
