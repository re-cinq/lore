{
 "uid": "lore-factory-overview",
 "title": "Lore \u00b7 Factory overview",
 "description": "What is happening on the floor right now: runs, visits, agents, buses, spend.",
 "tags": [
  "lore"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": true,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "type": "constant",
    "name": "cpu_hour_usd",
    "label": "Autopilot $/vCPU-hour",
    "query": "0.0489",
    "hide": 2,
    "current": {
     "value": "0.0489"
    }
   },
   {
    "type": "constant",
    "name": "mem_gib_hour_usd",
    "label": "Autopilot $/GiB-hour",
    "query": "0.0054",
    "hide": 2,
    "current": {
     "value": "0.0054"
    }
   }
  ]
 },
