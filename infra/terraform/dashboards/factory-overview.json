  {
   "type": "timeseries",
   "title": "Pod cost estimate per hour, by namespace (requests \u00d7 Autopilot rates)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 46,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\",namespace=~\"floor|lore-api|lore-stations|lore-ui|lore-db|monitoring\"}) * $cpu_hour_usd + sum by (namespace) (kube_pod_container_resource_requests{resource=\"memory\",namespace=~\"floor|lore-api|lore-stations|lore-ui|lore-db|monitoring\"}) / 1073741824 * $mem_gib_hour_usd",
