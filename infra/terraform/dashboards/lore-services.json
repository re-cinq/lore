{
 "uid": "lore-services",
 "title": "Lore \u00b7 Services",
 "description": "lore-api, the stations service and the lore-mcp gateway: requests, what agent pods ask for, stations and the bus.",
 "tags": [
  "lore"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
