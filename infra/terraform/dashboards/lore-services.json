   {
    "type": "query",
    "name": "service",
    "label": "Service",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(lore_http_requests_total, job)",
     "refId": "var"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "sort": 1,
    "current": {},
    "options": [],
    "allValue": ".*"
   }
  ]
