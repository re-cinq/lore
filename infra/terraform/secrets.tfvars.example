# ---------------------------------------------------------------------------
# Terraform variables for the Lore platform.
#
# Copy this file to `secrets.tfvars` and replace every value with your own.
# `secrets.tfvars` is gitignored — NEVER commit real secret material.
# Most values are also mirrored into GCP Secret Manager (see the tfvars↔GSM
# reconcile flow); resolve an existing one with:
#   gcloud secrets versions access latest --secret=<name>
# ---------------------------------------------------------------------------

# --- GCP project + GKE cluster ---
project_id   = "your-gcp-project-id"
cluster_name = "your-gke-cluster"
region       = "europe-west1"

# --- Public URLs + hostnames (drive the Terraform-owned ingresses) ---
lore_api_url     = "https://lore-api.example.com"
lore_ui_url      = "https://lore.example.com"
lore_ui_hostname = "lore.example.com"
# Shared agent MCP gateway. Empty ("") disables its ingress and leaves the
# seeded agent recipes without a live MCP endpoint (the mcp_servers block is
# omitted). Set it to turn agent MCP access on.
lore_mcp_url = "https://lore-mcp.example.com"
# GitHub-webhook ingress host for the Floor. Empty ("") disables that ingress.
lore_webhook_hostname = "lore-webhook.example.com"
github_org            = "your-github-org"

# --- GitHub App (Lore's bot identity) ---
github_app_id              = "123456"
github_app_installation_id = "7891011"
# The App private key (PEM). A heredoc keeps the newlines intact — do NOT
# collapse it to a single \n-escaped string.
github_app_private_key = <<-EOT
-----BEGIN RSA PRIVATE KEY-----
...replace with your GitHub App private key...
-----END RSA PRIVATE KEY-----
EOT

# --- Model provider keys ---
anthropic_api_key = "sk-ant-api03-..."
open_ai_api_key   = "sk-..."

# --- Datastore + internal tokens ---
db_password  = "super-secret-db-password"
ingest_token = "lore-ingest-token-value"

# Pre-shared token new execution clusters present to register (optional —
# leave empty to disable satellite registration).
cluster_agent_registration_token = "cluster-agent-registration-token-value"
# GitHub webhook HMAC secret (must match the value configured on the webhooks).
webhook_secret = "whsec_..."
# Shared secret between mcp-server and lore-floor. Generate with:
#   openssl rand -hex 32
agent_internal_token = "lore-internal-..."

# --- Slack (/lore slash command) ---
slack_signing_secret = "your-slack-signing-secret"
slack_bot_token      = "xoxb-..."

# --- Web UI OAuth (GitHub) ---
github_oauth_client_id     = "Iv1.abc123"
github_oauth_client_secret = "ghs_..."
# Session encryption secret. Generate with:
#   openssl rand -base64 32
nextauth_secret = "openssl-rand-base64-32-output"

# Base64-encoded .dockerconfigjson for GHCR pull access. Generate with:
#   echo '{"auths":{"ghcr.io":{"auth":"'"$(printf '%s' "USER:TOKEN" | base64)"'"}}}' | base64
ghcr_pull_secret_dockerconfigjson = "eyJhdXRocyI6ey..."
