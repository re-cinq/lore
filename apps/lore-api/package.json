{
  "name": "@re-cinq/lore-api",
  "version": "0.1.0",
  "description": "Lore API \u2014 HTTPS REST backend serving org context, ingest, tasks, and webhooks",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:watch": "node --watch-path=./dist --watch-path=../../libs/shared/dist --watch-path=../../libs/server-core/dist dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "node dist/openapi/gen-openapi.js",
    "gen:api-types": "npx --yes openapi-typescript@7.13.0 openapi.json -o ../web-ui/src/lib/api/schema.d.ts && npx --no-install prettier --write ../web-ui/src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.20.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.4.0",
    "@google-cloud/storage": "^7.19.0",
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "21.4.9",
    "@octokit/auth-app": "^7.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@re-cinq/agent-contracts": "^0.10.0",
    "@re-cinq/lore-assembly-lines": "*",
    "@re-cinq/lore-server-core": "*",
    "@re-cinq/lore-shared": "*",
    "glob": "^11.0.1",
    "minimatch": "^10.0.1",
    "octokit": "^4.1.0",
    "pg": "^8.13.0",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.7.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.1",
    "@re-cinq/lore-station-registry": "*"
  },
  "devDependencies": {
    "@types/hapi__hapi": "^20.0.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
