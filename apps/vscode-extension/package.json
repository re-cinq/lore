{
  "name": "lore-vscode",
  "displayName": "Lore — spec ↔ code",
  "description": "Highlights source lines that fulfil a spec statement and links to the local spec, tests, and ADRs.",
  "version": "0.3.2",
  "private": true,
  "publisher": "re-cinq",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/re-cinq/lore.git",
    "directory": "apps/vscode-extension"
  },
  "license": "Apache-2.0",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lore.refresh",
        "title": "Lore: Refresh spec ↔ code links"
      },
      {
        "command": "lore.toggleHighlights",
        "title": "Lore: Toggle spec highlights"
      },
      {
        "command": "lore.openLocal",
        "title": "Lore: Open local file at line"
      },
      {
        "command": "lore.explainSelection",
        "title": "Lore: What does this do?"
      }
    ],
    "configuration": {
      "title": "Lore",
      "properties": {
        "lore.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Lore API base URL. Falls back to `git config --global lore.api-url` when empty."
        },
        "lore.token": {
          "type": "string",
          "default": "",
          "description": "Lore API bearer token (read scope). Falls back to `git config --global lore.ingest-token` when empty."
        },
        "lore.highlightImplemented": {
          "type": "boolean",
          "default": true,
          "description": "Highlight lines an inline ([code](file#Lnn)) link marks as implementing a spec statement."
        },
        "lore.highlightCovered": {
          "type": "boolean",
          "default": true,
          "description": "Highlight lines a spec-linked test exercises (coverage layer, from the remote graph)."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "lore.explainSelection",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "lore@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --skip-license -o lore-vscode.vsix"
  },
  "dependencies": {
    "@re-cinq/lore-shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
