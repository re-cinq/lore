{
  "name": "@re-cinq/lore-stations",
  "version": "0.1.0",
  "description": "Lore stations \u2014 standalone units of work, one endpoint each (ADR-024 service-endpoint stations)",
  "type": "module",
  "main": "./dist/work/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start:watch": "node --watch-path=./dist --watch-path=../../libs/shared/dist dist/index.js"
  },
  "dependencies": {
    "@hapi/hapi": "21.4.10",
    "@octokit/auth-app": "^8.3.1",
    "@re-cinq/lore-shared": "*",
    "octokit": "^5.0.5",
    "pg": "^8.23.0",
    "zod": "^4.5.4",
    "@re-cinq/lore-assembly-lines": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/work/index.d.ts",
      "default": "./dist/work/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "types": "./dist/work/index.d.ts",
  "bin": {
    "lore-station": "./dist/transport/cli/main.js"
  }
}
