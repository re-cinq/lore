{
  "name": "@re-cinq/lore-cluster-agent",
  "version": "0.1.0",
  "description": "Lore cluster agent \u2014 the only process that talks to this cluster's Kubernetes API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "start:watch": "node --watch-path=./dist --watch-path=../../libs/shared/dist dist/index.js"
  },
  "dependencies": {
    "@hapi/hapi": "21.4.9",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/auth-app": "^7.1.0",
    "@re-cinq/agent-contracts": "^0.10.0",
    "@re-cinq/lore-shared": "*",
    "octokit": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/hapi__hapi": "^20.0.13",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
