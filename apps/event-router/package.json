{
  "name": "@re-cinq/lore-event-router",
  "version": "0.1.0",
  "description": "Lore event router \u2014 the one writer of pipeline.events (GitHub webhooks + the Agent CR watch)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
