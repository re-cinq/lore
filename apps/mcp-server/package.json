{
  "name": "@re-cinq/lore-mcp",
  "version": "0.1.0",
  "description": "Lore MCP server — serves org context, ADRs, and search to Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node ../../scripts/preflight-worktree.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:watch": "node --watch-path=./dist --watch-path=../../libs/shared/dist dist/index.js",
    "dev": "tsc --watch",
    "pretest": "node ../../scripts/preflight-worktree.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@re-cinq/lore-shared": "*",
    "@re-cinq/lore-server-core": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "glob": "^11.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
