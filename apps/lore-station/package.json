{
  "name": "@re-cinq/lore-station",
  "version": "0.1.0",
  "description": "Station pod entrypoint — runs one assembly-line node per pod (validate/detect/…), speaking the station contract (station_input JSON in, LORE_NODE_RESULT line out)",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "lore-station": "dist/main.js"
  },
  "scripts": {
    "prebuild": "node ../../scripts/preflight-worktree.mjs",
    "build": "tsc",
    "pretest": "node ../../scripts/preflight-worktree.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@re-cinq/lore-assembly-lines": "*",
    "@re-cinq/lore-shared": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
