{
  "name": "@re-cinq/lore-floor",
  "version": "0.1.0",
  "description": "Lore agent runner — processes pipeline tasks via Anthropic API, runs scheduled jobs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:watch": "node --watch-path=./dist --watch-path=../../libs/shared/dist dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:catalog": "node dist/delivery/gen-catalog.js",
    "job": "node dist/delivery/job-runner.js",
    "jobs:all": "for j in context_reindex eval_runner context_core_builder importance_decay consolidation autoresearch gap_detection spec_drift spec_test_linker memory_ttl; do echo \"[jobs:all] === $j ===\"; node dist/delivery/job-runner.js $j || exit 1; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.20.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.4.1",
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "21.4.9",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/auth-app": "^7.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@re-cinq/agent-contracts": "^0.9.0",
    "@re-cinq/lore-assembly-lines": "*",
    "@re-cinq/lore-shared": "*",
    "cron-parser": "^4.9.0",
    "google-auth-library": "^9.15.1",
    "libsodium-wrappers": "^0.8.2",
    "minimatch": "^10.0.1",
    "octokit": "^4.1.0",
    "pg": "^8.13.0",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/hapi__hapi": "^20.0.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
