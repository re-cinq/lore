# Node.js
# No trailing slash: a worktree's node_modules is often a symlink, and a
# trailing slash matches directories only (it would be committed otherwise).
node_modules
dist/
build/
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl
*.tfplan

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage
coverage/

# Next.js
.next/
next-env.d.ts
*.tsbuildinfo

# Claude Code
.claude/worktrees/
.claude/tsc-cache/
.lore-bootstrap.lock/

# Lore local runner — per-task ephemeral state, not for commit
.lore-task.json

# Local dev Postgres data (scripts/dev-local.sh bind mount)
.lore-pgdata/

# Local dev Dgraph data (npm run dgraph:up bind mount)
.lore-dgraphdata/

# Local dev NextAuth secret (generated by scripts/dev-local.sh)
.lore-nextauth-secret

# Local dev secrets/overrides sourced by scripts/dev-local.sh
.env.local

# Minikube-only kubeconfig (generated by scripts/infra/setup-minikube-agents.sh);
# carries cluster credentials, so it never belongs in git
.lore-kubeconfig-minikube


# Local copies of the prod database (scripts/infra/pull-prod-db.sh) — org data in the
# clear, so it must never reach git
.lore-dumps/

# Local dev GitHub App private key
.lore-github-app.pem
.claude/scheduled_tasks.lock
vscode-extension/lore-vscode-0.1.0.vsix
output/
.lore-archive/

# Helm dependency artifacts. `helm dependency update` writes a Chart.lock and
# vendors each dependency as a .tgz under charts/; the render checks delete both
# on every run (see scripts/check-cluster-agent-standalone-render.sh's cleanup).
# They were committed by accident once — a `git add -A` after running the pilot's
# helm upgrade — and no chart in this tree tracks them.
**/Chart.lock
infra/terraform/modules/gke-mcp/**/charts/*.tgz

# jscpd duplication reports (npm run dup)
reports/
