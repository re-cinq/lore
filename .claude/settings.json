{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ [ -d \"$CLAUDE_PROJECT_DIR/node_modules\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/.lore-bootstrap.lock\" ]; } || bash \"$CLAUDE_PROJECT_DIR/scripts/worktree-bootstrap.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
