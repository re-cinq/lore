# Local dev secrets for the full stack (npm start -> scripts/dev-local.sh).
# Copy to .env.local (gitignored) and fill in the values.
# Full instructions: docs/building-lore/contributing.md -> "Agent credentials".
#
# This is the ROOT .env.local — credentials for the Floor (pipeline tasks).
# The web-UI login OAuth creds live separately in apps/web-ui/.env.local.

# ── GitHub App (required: the Floor creates branches/PRs via App auth only) ──
# See apps/floor/src/adapters/github.ts. Missing these => every pipeline task
# (onboard, implementation, review) fails with:
#   "GitHub App not configured — cannot create PR"
# The PEM is consumed raw (no \n un-escaping) — paste it with REAL line breaks,
# keeping the surrounding double quotes.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
PASTE_PEM_HERE_WITH_REAL_LINE_BREAKS
-----END RSA PRIVATE KEY-----"



# Spec-traceability graph projection (local Dgraph via npm run dgraph:up)
LORE_DGRAPH_HTTP=http://localhost:8081

# --- Station LLM billing (ADR-028) ---
# Explicit opt-in: prefer your LOCAL Claude subscription (~/.claude) when available,
# else fall back to ANTHROPIC_API_KEY. Never silent.
LORE_STATION_ALLOW_PERSONAL_AUTH=1
# ── LLM credential (required: onboard/impl generate files via Llm.instance) ──
ANTHROPIC_API_KEY=

# ── Optional ──
# LORE_STATION_BACKEND=inprocess   # skip Docker for the lightweight planning path



