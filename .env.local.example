# Copy to .env.local and fill in. The one env file `npm start` reads (scripts/dev/start.tsx).
# .env.local is gitignored — never commit real secrets.

# --- Which backend ---------------------------------------------------------
# Unset or http://localhost:3001  -> `npm start` runs the WHOLE stack locally
#   (docker Postgres, lore-api :3001, stations :3004, MCP gateway :3002, UI :3000).
# Any other URL (e.g. https://lore-api.gcp.re-cinq.com) -> `npm start` runs ONLY
#   the web UI on :3000 against that backend. No docker, no build, no token:
#   you sign in through that lore-api (ADR-053).
# LORE_API_URL=
# Optional: the socket address when it differs from LORE_API_URL (ws(s)://.../api/ws)
# LORE_WS_URL=

# --- Agent layer (local mode) ----------------------------------------------
# A re-cinq/floor checkout: its own `npm start` runs the floor API (:8180), the
# cluster agent and installs the ai-agent-subsystem into minikube. Found at
# ../floor by default; `npm start` here starts it and shows it in the table.
# FLOOR_DIR=../floor
# LORE_DEV_FLOOR=0        # run Lore without the agent layer even when ../floor exists
# FLOOR_AGENTS=0          # forwarded to the floor: API only, no cluster agent / minikube

# --- GitHub OAuth app for web-ui login (run by lore-api, ADR-053) ---
# lore-api holds these and runs the GitHub sign-in; the web UI needs none of them.
# Create at: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3001/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: restrict sign-in to members of this GitHub org (blank = any GitHub
# account can sign in, and every signed-in person is a Lore admin).
GITHUB_ORG=

# --- Agent runs (everything below is filled in by `npm run dev-setup`) ---

# The agent pods' LLM credential — set exactly ONE. The pod runs the real `claude`
# CLI, which reads either from its environment, and setup-minikube-agents.sh wires
# whichever it finds through agent-secrets and the seeded recipes.
#   CLAUDE_CODE_OAUTH_TOKEN — your subscription (`claude setup-token`). No org API
#     credit needed. Shares rate limits with your interactive sessions.
#   ANTHROPIC_API_KEY — org billing, what GKE uses. Wins if both are set.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# How the agent pods clone and push. A PAT with `repo` scope is enough; the three
# GITHUB_APP_* vars below take precedence when all three are set.
GITHUB_TOKEN=

# ghcr.io/re-cinq/ai-agent is a private package, so pulling the run image needs a
# PAT with `read:packages` (the controller image is public).
GHCR_USER=
GHCR_TOKEN=

# Optional: GitHub App creds for README/PR features (web-ui repo header + mcp-server)
# and, when all three are set, for minting installation tokens instead of the PAT.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# Optional: minikube profile to target (default `minikube`). The setup script pins
# every kubectl/helm call and the Floor's CR dispatch to this context, so a GKE
# current-context cannot swallow your local runs.
# MINIKUBE_PROFILE=minikube
